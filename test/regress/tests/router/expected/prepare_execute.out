\c regress
DROP TABLE IF EXISTS xx;
NOTICE: send query to shard(s) : sh1,sh2,sh3,sh4
NOTICE: send query to shard(s) : sh1,sh2,sh3,sh4
CREATE TABLE xx (col1 INT);
NOTICE: send query to shard(s) : sh1,sh2,sh3,sh4
NOTICE: send query to shard(s) : sh1,sh2,sh3,sh4
INSERT INTO xx (col1) VALUES (1);
NOTICE: send query to shard(s) : sh1
INSERT INTO xx (col1) VALUES (2);
NOTICE: send query to shard(s) : sh2
PREPARE p1(int) AS SELECT col1 FROM xx WHERE col1 = $1;
EXECUTE p1(1);
NOTICE: send query to shard(s) : sh1
 col1 
------
    1
(1 row)

EXECUTE p1(2);
NOTICE: send query to shard(s) : sh2
 col1 
------
    2
(1 row)

PREPARE p2(int) AS INSERT INTO xx (col1) VALUES ($1);
EXECUTE p2(3);
NOTICE: send query to shard(s) : sh2
EXECUTE p2(4);
NOTICE: send query to shard(s) : sh2
SELECT col1 FROM xx ORDER BY col1;
NOTICE: send query to shard(s) : sh1,sh2,sh3,sh4
 col1 
------
    1
    2
    3
    4
(4 rows)

DEALLOCATE p1;
DEALLOCATE p2;
